# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# --- Model ---
# Primary: Groq (fast hosted inference). Leave GROQ_API_KEY blank to skip
# Groq entirely and go straight to the local Ollama model below.
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Final fallback if Groq is unreachable (invalid key, rate-limited, outage).
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Budget (soft internal guard; the real hard stop is the GCP Budget alert) ---
BUDGET_EUR_CAP=235
HOURLY_COST_ESTIMATE_EUR=0.35
BUDGET_SOFT_STOP_FRACTION=0.8

# --- Email approval gate ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
APPROVAL_NOTIFY_TO=rayan@studiofanoos.nl
APPROVAL_SERVICE_URL=

# --- Google Drive knowledge base ---
# Share the Drive folder with the VM's own service account (printed by
# 01_setup_infra.sh) -- no key file needed, Lauren authenticates as herself.
GDRIVE_FOLDER_ID=

# --- GCP ---
# Use your actual project ID (check with: gcloud config get-value project),
# not necessarily "lauren-nestor" -- that may just be the display name.
GCP_PROJECT_ID=
GCP_ZONE=us-central1-a
GCP_INSTANCE_NAME=lauren-nestor-vm
